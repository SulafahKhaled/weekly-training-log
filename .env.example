# Copy this file to .env for local development (never commit .env itself).

# Postgres connection string.
# Local dev (docker run postgres, see documentation.md):
DATABASE_URL=postgres://postgres:devpassword@localhost:5432/weekly_training_log
# Production (Vercel): set this in the Vercel project's Environment Variables
# instead — the Vercel Postgres integration fills it in automatically when
# you add the Postgres storage add-on to the project.

# Random secret used to sign session cookies. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set a DIFFERENT value in Vercel's Environment Variables for production —
# don't reuse the one you generate for local dev.
SESSION_SECRET=replace-with-a-random-64-char-hex-string
